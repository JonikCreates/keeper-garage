{
  "name": "keeper-garage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:github-pages": "tsc --noEmit && vite build --mode github-pages",
